# Database
# PostgreSQL — production (Render / managed DB) and local dev default
DATABASE_URL="postgresql://user:password@localhost:5432/examcoach"
# Optional: uncomment and copy value from above if Prisma asks for it
# DIRECT_URL="postgresql://user:password@localhost:5432/examcoach"

# NextAuth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional - credentials login works without it)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Google Gemini (AI flashcards, mock exams, Feynman coach)
GEMINI_API_KEY=""

# PayPal subscriptions
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_ENV="sandbox"
PAYPAL_WEBHOOK_ID=""
PAYPAL_PLAN_INDIVIDUAL=""
PAYPAL_PLAN_FAMILY=""
PAYPAL_PLAN_SCHOOL=""
PAYPAL_PLAN_MINISTRY=""
PAYPAL_PLAN_NGO=""

# Vercel Blob storage for uploads (optional in development)
BLOB_READ_WRITE_TOKEN=""

# First user with this email is promoted to admin
ADMIN_EMAIL=""
