generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("user") // "user" | "admin"
  locale        String    @default("en") // "en" | "nd" | "sn"
  theme         String    @default("system") // "light" | "dark" | "system"
  orgId         String?
  orgIdCode     String?   @unique
  resetCode     String?
  resetCodeExpiresAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  subscriptions Subscription[]
  studyGoal     StudyGoal?
  studySessions StudySession[]
  documents     Document[]
  flashcards    Flashcard[]
  quizResults   QuizResult[]
  mockExams     MockExam[]
  payments      Payment[]
  organization  Organization? @relation(fields: [orgId], references: [id])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  prefix    String   @unique // e.g., "GR"
  colors    Json?    // { primary: string, accent: string }
  
  // Resource Limits
  dailyUploadsLimit    Int     @default(1000)
  studyMethodsCount    Int     @default(14)
  maxFileSizeMb        Int     @default(100)
  maxMockExamQuestions Int     @default(100)
  groqTokensLimit      Int     @default(5000000)
  seatLimit            Int     @default(100)
  priorityAiProcessing Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
  ids   OrgID[]
}

model OrgID {
  id             String    @id @default(cuid())
  code           String    @unique // e.g., "GR-123456"
  tempPassword   String
  isClaimed      Boolean   @default(false)
  status         String    @default("trial") // "trial" | "paid"
  trialEndsAt    DateTime?
  orgId          String
  userId         String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

// Removed PasswordResetCode model as it's now in User

model Payment {
  id            String   @id @default(cuid())
  userId        String
  amount        Float
  currency      String   @default("USD")
  status        String   // "pending" | "completed" | "failed" | "rejected"
  reference     String   @unique
  gateway       String   // "paynow" | "paypal" | "ecocash"
  gatewayRef    String?  // Paynow Poll URL or PayPal Order ID or EcoCash Ref
  
  // Manual EcoCash Fields
  phoneNumber   String?
  schoolName    String?
  contactDetails String?
  verificationNote String?
  adminId       String?

  tier          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String
  tier             String // free_trial, individual, family, school, ministry, ngo
  paypalSubId      String?   @unique
  status           String // active, cancelled, expired, past_due
  trialStartDate   DateTime  @default(now())
  trialEndDate     DateTime?
  currentPeriodEnd DateTime?
  gracePeriodEnd   DateTime?
  seats            Int       @default(1)
  maxSeats         Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subAccounts SubAccount[]
}

model SubAccount {
  id             String   @id @default(cuid())
  subscriptionId String
  name           String
  email          String?  @unique
  createdAt      DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

model StudyGoal {
  id           String   @id @default(cuid())
  userId       String   @unique
  dailyMinutes Int      @default(20)
  weeklyTopics Int      @default(5)
  weeklyMinutes Int     @default(120)
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StudySession {
  id            String   @id @default(cuid())
  userId        String
  date          DateTime @default(now())
  durationMin   Int
  method        String   @default("flashcards")
  topicsStudied String[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model Document {
  id        String    @id @default(cuid())
  userId    String
  filename  String
  fileUrl   String
  fileType  String
  topics    String[]
  parsedAt  DateTime?
  createdAt DateTime  @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcards Flashcard[]
}

model Flashcard {
  id             String    @id @default(cuid())
  userId         String
  documentId     String?
  topic          String
  question       String    @db.Text
  answer         String    @db.Text
  confidence     String?
  lastReviewed   DateTime?
  nextReview     DateTime?
  reviewInterval Int       @default(0) // in days
  createdAt      DateTime  @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  document Document? @relation(fields: [documentId], references: [id])
}

model QuizResult {
  id             String   @id @default(cuid())
  userId         String
  topic          String
  score          Float
  totalQuestions Int
  answers        Json
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MockExam {
  id          String    @id @default(cuid())
  userId      String
  title       String
  questions   Json
  score       Float?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyUpload {
  id     String   @id @default(cuid())
  userId String
  date   DateTime @db.Date
  count  Int      @default(0)

  @@unique([userId, date])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
